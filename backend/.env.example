# Set server environment variables before starting uvicorn. Never commit keys.
# GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_BLUEPRINT_MODEL=gemini-4-argon
# Loopback access is enabled by default. For a hosted/private deployment:
# ARGON_API_TOKEN=generate-a-long-random-token
# ARGON_OWNER_ID=your-owner-id
# ARGON_DATA_DIR=/persistent-volume/argon
# ARGON_FRONTEND_DIST=/path/to/frontend/dist

# Optional bounded tool-turn budget (16..1024; default512).
ARGON_MAX_AGENT_TURNS=512
